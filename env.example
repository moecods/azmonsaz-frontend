NEXT_PUBLIC_USE_MOCK_DATA=false

# Application Configuration
NEXT_PUBLIC_APP_NAME=Azmoon-Saz
NEXT_PUBLIC_APP_VERSION=1.0.0

# Development Configuration
NODE_ENV=development

# Optional: Analytics and Monitoring
